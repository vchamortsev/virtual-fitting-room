# Ключи магазинов через запятую. Каждый магазин передаёт свой ключ в X-API-Key.
API_KEYS=local-dev-key

HOST=127.0.0.1
PORT=8080
# Для встройки с чужого домена перечислите адреса через запятую. Звёздочка — любой.
CORS_ORIGINS=*

DATA_DIR=data
PUBLIC_BASE_URL=
RETENTION_HOURS=48
RATE_LIMIT_PER_MINUTE=30
MAX_UPLOAD_MB=12

# auto: FASHN, если веса на месте, иначе черновик mock.
# catvton-flux в авторежим не попадает: у FLUX некоммерческая лицензия.
DEFAULT_MODEL=auto

FASHN_WEIGHTS_DIR=weights/fashn-vton-1.5
# Пусто — cuda, если есть, иначе cpu. Можно указать cuda или cpu.
FASHN_DEVICE=

# CatVTON-FLUX локально. Для витрины магазина оставьте false, пока нет коммерческой лицензии FLUX.
ENABLE_CATVTON_FLUX=false
CATVTON_OFFLOAD=true
CATVTON_WIDTH=576
CATVTON_HEIGHT=768
# HF_TOKEN=hf_...
